{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocalSettings",
  "type": "object",
  "required": [
    "cache",
    "mountpoint",
    "profile_id"
  ],
  "properties": {
    "cache": {
      "$ref": "#/definitions/CacheSettings"
    },
    "mountpoint": {
      "$ref": "#/definitions/Mountpoint"
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "runtime": {
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeSettings"
        }
      ]
    }
  },
  "definitions": {
    "CacheSettings": {
      "type": "object",
      "required": [
        "cache_dir",
        "cache_size_mib"
      ],
      "properties": {
        "cache_dir": {
          "type": "string"
        },
        "cache_size_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Mountpoint": {
      "type": "object",
      "required": [
        "path",
        "platform"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/definitions/Platform"
        }
      }
    },
    "Platform": {
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows"
      ]
    },
    "RuntimeSettings": {
      "type": "object",
      "properties": {
        "last_connected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_local_postgres_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "last_local_s3_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        }
      }
    }
  }
}