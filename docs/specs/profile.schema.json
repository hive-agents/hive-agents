{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profile",
  "type": "object",
  "required": [
    "created_at",
    "display_name",
    "juicefs",
    "profile_id",
    "profile_version",
    "ssh",
    "tunnels"
  ],
  "properties": {
    "profile_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ssh": {
      "$ref": "#/definitions/SshConfig"
    },
    "tunnels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TunnelConfig"
      }
    },
    "juicefs": {
      "$ref": "#/definitions/JuiceFsConfig"
    }
  },
  "definitions": {
    "SshConfig": {
      "type": "object",
      "required": [
        "host",
        "host_key_fingerprint_sha256",
        "identity_key_ref",
        "port",
        "user"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "user": {
          "type": "string"
        },
        "host_key_fingerprint_sha256": {
          "type": "string"
        },
        "identity_key_ref": {
          "type": "string"
        }
      }
    },
    "TunnelConfig": {
      "type": "object",
      "required": [
        "local_bind_host",
        "local_port",
        "name",
        "remote_host",
        "remote_port"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "remote_host": {
          "type": "string"
        },
        "remote_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "local_bind_host": {
          "type": "string"
        },
        "local_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "JuiceFsConfig": {
      "type": "object",
      "required": [
        "meta",
        "object",
        "volume_name"
      ],
      "properties": {
        "volume_name": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/definitions/JuiceFsMetaConfig"
        },
        "object": {
          "$ref": "#/definitions/JuiceFsObjectConfig"
        }
      }
    },
    "JuiceFsMetaConfig": {
      "type": "object",
      "required": [
        "database",
        "dsn_template",
        "engine",
        "password_ref",
        "user"
      ],
      "properties": {
        "engine": {
          "$ref": "#/definitions/MetaEngine"
        },
        "user": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "password_ref": {
          "type": "string"
        },
        "dsn_template": {
          "type": "string"
        }
      }
    },
    "MetaEngine": {
      "type": "string",
      "enum": [
        "postgres"
      ]
    },
    "JuiceFsObjectConfig": {
      "type": "object",
      "required": [
        "access_key_ref",
        "bucket_name",
        "bucket_url_template",
        "endpoint_mode",
        "secret_key_ref",
        "storage"
      ],
      "properties": {
        "storage": {
          "$ref": "#/definitions/StorageKind"
        },
        "bucket_name": {
          "type": "string"
        },
        "endpoint_mode": {
          "$ref": "#/definitions/EndpointMode"
        },
        "bucket_url_template": {
          "type": "string"
        },
        "access_key_ref": {
          "type": "string"
        },
        "secret_key_ref": {
          "type": "string"
        }
      }
    },
    "StorageKind": {
      "type": "string",
      "enum": [
        "s3"
      ]
    },
    "EndpointMode": {
      "type": "string",
      "enum": [
        "tunneled",
        "direct"
      ]
    }
  }
}